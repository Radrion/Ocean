git rm --cached .env
git rm --cached *.sqlite3
git commit -m "Remove sensitive files from tracking"
# Credentials — never upload these
.env

# Databases — contain sensitive security data
*.sqlite3
*.db

# Data files
*.csv

# Python cache files — auto-generated, not needed
__pycache__/
*.pyc
*.pyo

# VSCode settings — personal to your machine
.vscode/